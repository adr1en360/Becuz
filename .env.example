# Zetaris (AWS-hosted cluster). Use the api. host; the bare cluster host does not resolve.
ZETARIS_REST_URL=https://api.<cluster-id>.cloud.zetaris.com/api/v1.0
ZETARIS_ORG_ID=<org-id>
ZETARIS_API_KEY=<api-key>

# Optional JDBC (REST needs none of these).
# ZETARIS_JDBC_URL=jdbc:zetaris:lightning@<host>:10000
# ZETARIS_JDBC_JAR=C:\full\path\to\zetaris-driver.jar
# ZETARIS_USERNAME=
# ZETARIS_PASSWORD=
# ZETARIS_USER_AGENT="app_name user@domain.tld"

# Optional UI-proxy helpers. This is the web UI origin, not the direct API.
# ZETARIS_BASE_URL=https://<instance-host>
# ZETARIS_QUERY_LIMIT=1000
# ZETARIS_ENGINE_ID=

# Nightshift (primary AI provider)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_MODEL=meterless/auto
# The token is read from %LOCALAPPDATA%\ai.meterless.runtime\proxy-token.
# Set this only if you need to override it.
METERLESS_RUNTIME_TOKEN=

# Optional. Relative evidence paths resolve under Becuz/ (not the shell's cwd).
# Set LEDGER_PATH, TRACE_PATH or MEMORY_PATH to none (or off) to turn it off.
LEDGER_PATH=logs/ledger.jsonl
TRACE_PATH=logs/trace.jsonl
MEMORY_PATH=logs/memory.json

# Scaffold
SAMPLE_MODE=0
AGENT_POLICY=
MAX_STEPS=6
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
