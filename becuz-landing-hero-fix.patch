+/* Landing page: smooth, one-shot entrances. No loops, no layout shift. */
+.hero-glow {
+  background:
+    radial-gradient(42rem 22rem at 85% -4rem, rgb(255 122 61 / 0.22), transparent 60%),
+    radial-gradient(30rem 18rem at 8% 0, rgb(247 245 239 / 0.07), transparent 60%);
+}
+
+.hero-in {
+  animation: hero-rise 800ms cubic-bezier(0.22, 1, 0.36, 1) both;
+}
+
+@keyframes hero-rise {
+  /* Transform only, on purpose: the hero must stay fully legible even if
+     an animation is interrupted or a screenshot freezes it mid-sequence. */
+  from {
+    transform: translateY(18px);
+  }
+  to {
+    transform: translateY(0);
+  }
+}
+
+.pulse-dot {
+  animation: pulse-dot 2.2s ease-in-out infinite;
+}
+
+@keyframes pulse-dot {
+  0%,
+  100% {
+    box-shadow: 0 0 0 0 rgb(255 122 61 / 0.55);
+  }
+  60% {
+    box-shadow: 0 0 0 7px rgb(255 122 61 / 0);
+  }
+}
+
+.flow-line {
+  background: linear-gradient(90deg, var(--color-flare), rgb(247 245 239 / 0.25));
+  background-size: 200% 100%;
+  animation: flow-slide 2.4s cubic-bezier(0.22, 1, 0.36, 1) both;
+}
+
+@keyframes flow-slide {
+  from {
+    background-position: 100% 0;
+  }
+  to {
+    background-position: 0 0;
+  }
+}
+
+.reveal {
+  opacity: 0;
+  transform: translateY(16px);
+  transition:
+    opacity 700ms cubic-bezier(0.22, 1, 0.36, 1),
+    transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
+  transition-delay: var(--reveal-delay, 0ms);
+}
+
+.reveal[data-seen="true"] {
+  opacity: 1;
+  transform: translateY(0);
+}
+
+.metric-card {
+  box-shadow:
+    0 24px 60px rgb(0 0 0 / 0.35),
+    inset 0 1px 0 rgb(247 245 239 / 0.12);
+}
+
 @media (prefers-reduced-motion: reduce) {
   .print,
   .line-busy,
-  .stamp[data-seen="true"] {
+  .stamp[data-seen="true"],
+  .hero-in,
+  .pulse-dot,
+  .flow-line {
     animation: none;
   }
 
+  .reveal {
+    opacity: 1;
+    transform: none;
+    transition: none;
+  }
+
   .stamp {
     opacity: 0.9;
   }
