{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "cause_id": {
          "title": "Cause Id",
          "type": "string"
        },
        "action": {
          "title": "Action",
          "type": "string"
        }
      },
      "required": [
        "cause_id",
        "action"
      ],
      "title": "Action",
      "type": "object"
    },
    "Answer": {
      "additionalProperties": false,
      "description": "A direct answer to an everyday question, from one read-only SQL query; the model is not involved.",
      "properties": {
        "kind": {
          "enum": [
            "top_sellers",
            "totals",
            "expenses",
            "missing_money"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sentence": {
          "description": "The answer in one plain sentence",
          "title": "Sentence",
          "type": "string"
        },
        "rows": {
          "description": "Up to 5 rows, largest first (smallest first for 'least')",
          "items": {
            "$ref": "#/$defs/AnswerRow"
          },
          "title": "Rows",
          "type": "array"
        },
        "sql": {
          "description": "The query that produced the rows",
          "title": "Sql",
          "type": "string"
        },
        "row_ids": {
          "description": "Records behind the rows",
          "items": {
            "type": "string"
          },
          "title": "Row Ids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "sentence",
        "rows",
        "sql",
        "row_ids"
      ],
      "title": "Answer",
      "type": "object"
    },
    "AnswerRow": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value_ngn": {
          "description": "Naira in the period",
          "title": "Value Ngn",
          "type": "number"
        },
        "usual_ngn": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "The same measure averaged over the baseline windows; None when it has no baseline",
          "title": "Usual Ngn"
        },
        "detail": {
          "description": "Units, payments or a short note, e.g. '120 units'",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "label",
        "value_ngn",
        "usual_ngn",
        "detail"
      ],
      "title": "AnswerRow",
      "type": "object"
    },
    "CashGap": {
      "additionalProperties": false,
      "description": "Money the till recorded but the bank never received; impact_ngn is the missing amount (negative).\nIt is cash the shop is owed, so it is not part of the profit change.",
      "properties": {
        "cause_id": {
          "title": "Cause Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "status": {
          "const": "supported",
          "default": "supported",
          "title": "Status",
          "type": "string"
        },
        "impact_ngn": {
          "description": "Naira in the period; negative is a loss",
          "title": "Impact Ngn",
          "type": "number"
        },
        "impact_evidence_id": {
          "description": "Evidence row whose value_ngn is the impact",
          "title": "Impact Evidence Id",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "The model's rating of the evidence; None if it was unavailable",
          "title": "Confidence"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "falsified_by": {
          "items": {
            "$ref": "#/$defs/FalsificationTest"
          },
          "title": "Falsified By",
          "type": "array"
        },
        "depends_on_sources": {
          "description": "Zetaris sources the evidence read",
          "items": {
            "enum": [
              "pos_files",
              "bank_files",
              "books_files",
              "context_files"
            ],
            "type": "string"
          },
          "title": "Depends On Sources",
          "type": "array"
        },
        "retries": {
          "default": 0,
          "title": "Retries",
          "type": "integer"
        }
      },
      "required": [
        "cause_id",
        "title",
        "impact_ngn",
        "impact_evidence_id",
        "confidence",
        "evidence",
        "falsified_by",
        "depends_on_sources"
      ],
      "title": "CashGap",
      "type": "object"
    },
    "Cause": {
      "additionalProperties": false,
      "description": "A supported cause of the profit change; impact_ngn is its effect on the period's profit.",
      "properties": {
        "cause_id": {
          "title": "Cause Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "status": {
          "const": "supported",
          "default": "supported",
          "title": "Status",
          "type": "string"
        },
        "impact_ngn": {
          "description": "Naira in the period; negative is a loss",
          "title": "Impact Ngn",
          "type": "number"
        },
        "impact_evidence_id": {
          "description": "Evidence row whose value_ngn is the impact",
          "title": "Impact Evidence Id",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "The model's rating of the evidence; None if it was unavailable",
          "title": "Confidence"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "falsified_by": {
          "items": {
            "$ref": "#/$defs/FalsificationTest"
          },
          "title": "Falsified By",
          "type": "array"
        },
        "depends_on_sources": {
          "description": "Zetaris sources the evidence read",
          "items": {
            "enum": [
              "pos_files",
              "bank_files",
              "books_files",
              "context_files"
            ],
            "type": "string"
          },
          "title": "Depends On Sources",
          "type": "array"
        },
        "retries": {
          "default": 0,
          "title": "Retries",
          "type": "integer"
        },
        "component": {
          "description": "The tree node this cause explains",
          "enum": [
            "net_sales",
            "cogs",
            "wastage",
            "opex"
          ],
          "title": "Component",
          "type": "string"
        },
        "share_of_change_pct": {
          "title": "Share Of Change Pct",
          "type": "number"
        },
        "rank": {
          "description": "1 = largest effect",
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "origin": {
          "enum": [
            "internal",
            "external"
          ],
          "title": "Origin",
          "type": "string"
        },
        "nature": {
          "enum": [
            "actionable",
            "temporary"
          ],
          "title": "Nature",
          "type": "string"
        },
        "counterfactual_ngn": {
          "description": "This week's profit without this cause: headline.current_ngn - impact_ngn",
          "title": "Counterfactual Ngn",
          "type": "number"
        }
      },
      "required": [
        "cause_id",
        "title",
        "impact_ngn",
        "impact_evidence_id",
        "confidence",
        "evidence",
        "falsified_by",
        "depends_on_sources",
        "component",
        "share_of_change_pct",
        "rank",
        "origin",
        "nature",
        "counterfactual_ngn"
      ],
      "title": "Cause",
      "type": "object"
    },
    "Check": {
      "additionalProperties": false,
      "description": "The Checker's independent re-run of an evidence query, and its verdict.",
      "properties": {
        "match": {
          "title": "Match",
          "type": "boolean"
        },
        "rerun_value_ngn": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rerun Value Ngn"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Model that judged the evidence, as reported by Nightshift",
          "title": "Model"
        },
        "via": {
          "description": "nightshift or sample-rules",
          "title": "Via",
          "type": "string"
        },
        "signed": {
          "default": false,
          "title": "Signed",
          "type": "boolean"
        }
      },
      "required": [
        "match",
        "via"
      ],
      "title": "Check",
      "type": "object"
    },
    "Convergence": {
      "additionalProperties": false,
      "properties": {
        "explained_ngn": {
          "description": "Sum of supported causes' impact_ngn",
          "title": "Explained Ngn",
          "type": "number"
        },
        "explained_pct": {
          "title": "Explained Pct",
          "type": "number"
        },
        "unexplained_ngn": {
          "description": "headline.change_ngn - explained_ngn",
          "title": "Unexplained Ngn",
          "type": "number"
        }
      },
      "required": [
        "explained_ngn",
        "explained_pct",
        "unexplained_ngn"
      ],
      "title": "Convergence",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "table": {
          "description": "USL table the query read, e.g. becuz.supplier_invoices",
          "title": "Table",
          "type": "string"
        },
        "sql": {
          "title": "Sql",
          "type": "string"
        },
        "row_ids": {
          "description": "Record IDs behind the number",
          "items": {
            "type": "string"
          },
          "title": "Row Ids",
          "type": "array"
        },
        "value_ngn": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Ngn"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "via": {
          "enum": [
            "zetaris",
            "local"
          ],
          "title": "Via",
          "type": "string"
        },
        "check": {
          "anyOf": [
            {
              "$ref": "#/$defs/Check"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "evidence_id",
        "table",
        "sql",
        "row_ids",
        "summary",
        "via"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FalsificationTest": {
      "additionalProperties": false,
      "properties": {
        "test": {
          "description": "What would have disproved the cause, e.g. 'unit cost flat across the baseline'",
          "title": "Test",
          "type": "string"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "survived": {
          "description": "True if the cause survived the test",
          "title": "Survived",
          "type": "boolean"
        }
      },
      "required": [
        "test",
        "evidence_id",
        "survived"
      ],
      "title": "FalsificationTest",
      "type": "object"
    },
    "Frame": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "title": "Question",
          "type": "string"
        },
        "metric": {
          "const": "profit",
          "default": "profit",
          "title": "Metric",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "days": {
          "default": 7,
          "description": "The period's length in days, 1 to 28",
          "title": "Days",
          "type": "integer"
        },
        "baseline_start": {
          "description": "First day of the earliest baseline window",
          "format": "date",
          "title": "Baseline Start",
          "type": "string"
        },
        "baseline_end": {
          "description": "Last day of the latest baseline window",
          "format": "date",
          "title": "Baseline End",
          "type": "string"
        },
        "baseline": {
          "default": "",
          "description": "What the period is compared with, in the owner's words",
          "title": "Baseline",
          "type": "string"
        }
      },
      "required": [
        "question",
        "period_start",
        "period_end",
        "baseline_start",
        "baseline_end"
      ],
      "title": "Frame",
      "type": "object"
    },
    "Headline": {
      "additionalProperties": false,
      "properties": {
        "current_ngn": {
          "title": "Current Ngn",
          "type": "number"
        },
        "baseline_ngn": {
          "title": "Baseline Ngn",
          "type": "number"
        },
        "change_ngn": {
          "description": "current_ngn - baseline_ngn",
          "title": "Change Ngn",
          "type": "number"
        },
        "change_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "None when the baseline profit is zero",
          "title": "Change Pct"
        },
        "direction": {
          "enum": [
            "down",
            "up",
            "flat"
          ],
          "title": "Direction",
          "type": "string"
        }
      },
      "required": [
        "current_ngn",
        "baseline_ngn",
        "change_ngn",
        "change_pct",
        "direction"
      ],
      "title": "Headline",
      "type": "object"
    },
    "OwnerQuestion": {
      "additionalProperties": false,
      "properties": {
        "cause_id": {
          "title": "Cause Id",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "cause_id",
        "question"
      ],
      "title": "OwnerQuestion",
      "type": "object"
    },
    "Recall": {
      "additionalProperties": false,
      "description": "A cause the owner confirmed in an earlier run, recalled from H-MEM and tested first.",
      "properties": {
        "cause_id": {
          "title": "Cause Id",
          "type": "string"
        },
        "confirmed_at": {
          "description": "When the owner confirmed it (ISO timestamp)",
          "title": "Confirmed At",
          "type": "string"
        },
        "held_again": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "True if it was found again, False if not, None if this period could not test it",
          "title": "Held Again"
        },
        "confidence_before": {
          "description": "H-MEM confidence in the memory before this run",
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence Before",
          "type": "number"
        },
        "confidence_after": {
          "description": "H-MEM confidence after this run's result",
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence After",
          "type": "number"
        },
        "message": {
          "description": "Plain-language line for the owner",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "cause_id",
        "confirmed_at",
        "held_again",
        "confidence_before",
        "confidence_after",
        "message"
      ],
      "title": "Recall",
      "type": "object"
    },
    "RuledOut": {
      "additionalProperties": false,
      "properties": {
        "cause_id": {
          "title": "Cause Id",
          "type": "string"
        },
        "hypothesis": {
          "title": "Hypothesis",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "tested_value_ngn": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tested Value Ngn"
        },
        "evidence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        }
      },
      "required": [
        "cause_id",
        "hypothesis",
        "reason"
      ],
      "title": "RuledOut",
      "type": "object"
    },
    "Stats": {
      "additionalProperties": false,
      "properties": {
        "duration_s": {
          "title": "Duration S",
          "type": "number"
        },
        "zetaris_queries": {
          "title": "Zetaris Queries",
          "type": "integer"
        },
        "model_calls": {
          "title": "Model Calls",
          "type": "integer"
        },
        "retries": {
          "title": "Retries",
          "type": "integer"
        },
        "models": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Model name -> number of requests it handled",
          "title": "Models",
          "type": "object"
        },
        "via": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Route -> count, e.g. nightshift, zetaris, local, sample-rules",
          "title": "Via",
          "type": "object"
        }
      },
      "required": [
        "duration_s",
        "zetaris_queries",
        "model_calls",
        "retries",
        "models",
        "via"
      ],
      "title": "Stats",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "properties": {
        "what_happened": {
          "title": "What Happened",
          "type": "string"
        },
        "why": {
          "items": {
            "type": "string"
          },
          "title": "Why",
          "type": "array"
        },
        "cash": {
          "default": [],
          "description": "One line per cash gap, kept apart from profit",
          "items": {
            "type": "string"
          },
          "title": "Cash",
          "type": "array"
        },
        "outcome": {
          "default": "",
          "description": "What acting on the findings is worth, from the measured figures only; never a forecast",
          "title": "Outcome",
          "type": "string"
        },
        "what_to_do": {
          "items": {
            "$ref": "#/$defs/Action"
          },
          "title": "What To Do",
          "type": "array"
        }
      },
      "required": [
        "what_happened",
        "why",
        "what_to_do"
      ],
      "title": "Summary",
      "type": "object"
    },
    "TreeNode": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "enum": [
            "net_sales",
            "cogs",
            "wastage",
            "opex"
          ],
          "title": "Component",
          "type": "string"
        },
        "current_ngn": {
          "title": "Current Ngn",
          "type": "number"
        },
        "baseline_ngn": {
          "title": "Baseline Ngn",
          "type": "number"
        },
        "change_ngn": {
          "description": "current - baseline for this component (a cost rise is positive)",
          "title": "Change Ngn",
          "type": "number"
        },
        "profit_effect_ngn": {
          "description": "Effect on profit: equals change_ngn for net_sales, minus change_ngn for costs",
          "title": "Profit Effect Ngn",
          "type": "number"
        },
        "share_of_change_pct": {
          "description": "profit_effect_ngn as a percentage of the headline change",
          "title": "Share Of Change Pct",
          "type": "number"
        },
        "status": {
          "enum": [
            "explained",
            "partly_explained",
            "unexplained",
            "no_change"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "component",
        "current_ngn",
        "baseline_ngn",
        "change_ngn",
        "profit_effect_ngn",
        "share_of_change_pct",
        "status"
      ],
      "title": "TreeNode",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "errors": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "mode": {
      "enum": [
        "live",
        "sample"
      ],
      "title": "Mode",
      "type": "string"
    },
    "synthetic": {
      "description": "True when the shop data is generated test data",
      "title": "Synthetic",
      "type": "boolean"
    },
    "scenario": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Synthetic scenario id, e.g. s01",
      "title": "Scenario"
    },
    "frame": {
      "$ref": "#/$defs/Frame"
    },
    "headline": {
      "$ref": "#/$defs/Headline"
    },
    "tree": {
      "items": {
        "$ref": "#/$defs/TreeNode"
      },
      "title": "Tree",
      "type": "array"
    },
    "causes": {
      "items": {
        "$ref": "#/$defs/Cause"
      },
      "title": "Causes",
      "type": "array"
    },
    "cash_gaps": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CashGap"
      },
      "title": "Cash Gaps",
      "type": "array"
    },
    "memory": {
      "default": [],
      "description": "Owner-confirmed causes recalled from H-MEM for this run",
      "items": {
        "$ref": "#/$defs/Recall"
      },
      "title": "Memory",
      "type": "array"
    },
    "answer": {
      "anyOf": [
        {
          "$ref": "#/$defs/Answer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set when the question asks what happened (top sellers, totals, expenses, missing money) rather than why; then no causes are tested"
    },
    "ruled_out": {
      "items": {
        "$ref": "#/$defs/RuledOut"
      },
      "title": "Ruled Out",
      "type": "array"
    },
    "not_tested": {
      "description": "Possible causes the run did not test, and why",
      "items": {
